{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["agentId", "platform", "image"],
  "properties": {
    "agentId": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "platform": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://[^\\s/?#@]+(/[^\\s?#]*)?$"},
        "caBundle": {"type": "string"}
      },
      "additionalProperties": false
    },
    "enrollmentToken": {"type": "string"},
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "tag": {"type": "string", "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$"},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]}
      },
      "anyOf": [
        {"properties": {"digest": {"minLength": 1}}, "required": ["digest"]},
        {"properties": {"tag": {"minLength": 1}}, "required": ["tag"]}
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
            "maxLength": 253
          }
        },
        "additionalProperties": false
      }
    },
    "proxy": {
      "type": "object",
      "properties": {
        "https": {"type": "string", "pattern": "^(https?://[^\\s/?#]+/?)?$"},
        "http": {"type": "string", "pattern": "^(https?://[^\\s/?#]+/?)?$"},
        "noProxy": {"type": "string", "pattern": "^[^\\s]*$"}
      },
      "additionalProperties": false
    },
    "helmTimeout": {"type": "string", "pattern": "^[0-9]+(s|m)$"},
    "idleSeconds": {"type": "number", "minimum": 1},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 960},
    "resources": {"type": "object"},
    "networkPreflight": {
      "type": "object",
      "properties": {
        "image": {"type": "string", "pattern": "^([^\\s@]+@sha256:[a-f0-9]{64})?$"},
        "allowedImages": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$"}
        }
      },
      "additionalProperties": false
    },
    "tunnel": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"enum": ["auto", "kernel", "userspace"]},
        "intervalSeconds": {"type": "number", "minimum": 5},
        "exposeKubeApi": {"type": "boolean"},
        "resources": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
