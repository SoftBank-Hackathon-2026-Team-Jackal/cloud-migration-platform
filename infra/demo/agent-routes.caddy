# Public routes. The Agent API (/agents/*), the relay polling API (/relays/*), the browser's
# migration API (/migrations, /migrations/*) and Plan approval/preview (/provisioning/*) reach the
# backend; every other path is the web front end. #225: the web is built in real (sse) mode with
# NEXT_PUBLIC_API_BASE set to this origin, so the browser calls these paths directly (same origin,
# no CORS). /migrations has no authentication yet (accepted for the contest demo; follow-up:
# authentication); /provisioning/* approvals and previews still require an approver Bearer
# credential, and approver registration requires the approval admin key. Operator, enrollment and
# tunnel-admin routes (/agent-admin/*, /agent-enrollments, /tunnel-admin/*, /provisioning-admin/*,
# /connections, /env-files), /docs and /openapi.json stay on the loopback-bound API (SSM port
# forwarding) and still require keys: the web container calls the API on the internal network.
# Relay-host worker (cmp-demo-relay): Temporal gRPC over TLS, only from the allowed address. The
# default is a documentation address (RFC 5737), so nothing passes unless the operator sets it.
@temporal {
	path /temporal.api.* /grpc.health.v1.Health/*
	remote_ip {$CMP_TEMPORAL_ALLOWED_IP}
}
handle @temporal {
	reverse_proxy h2c://{$CMP_TEMPORAL_UPSTREAM}
}
# Migration event stream (SSE): forwarded without response buffering.
@migration_events path /migrations/*/events
handle @migration_events {
	reverse_proxy {$CMP_API_UPSTREAM} {
		flush_interval -1
	}
}
# Server pulse report (origin/target servers push CPU and memory; X-Pulse-Token required, off while
# PULSE_REPORT_TOKEN is empty). Only this POST is public: GET /system/pulse stays internal.
@pulse_report {
	method POST
	path /system/pulse/report
}
handle @pulse_report {
	reverse_proxy {$CMP_API_UPSTREAM}
}
# Relay traffic health report (the relay Envoy's origin/target 5xx and p99 per window; same
# X-Pulse-Token). Only this POST is public: GET /system/traffic-health stays internal.
@traffic_health_report {
	method POST
	path /system/traffic-health/report
}
handle @traffic_health_report {
	reverse_proxy {$CMP_API_UPSTREAM}
}
@backend path /agents/* /relays/* /migrations /migrations/* /provisioning/*
handle @backend {
	reverse_proxy {$CMP_API_UPSTREAM}
}
handle {
	reverse_proxy {$CMP_WEB_UPSTREAM}
}
