TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5433/platform
# Operator key for issuing one-time on-premises Agent enrollment tokens. Set a long random value outside Git.
AGENT_ENROLLMENT_ADMIN_KEY=
# Operator key for registering Plan approvers (ticket 07). Set a long random value outside Git.
APPROVAL_ADMIN_KEY=
# Ticket 08 worker: protected Planning artifact directory, named AWS profile and Terraform binary.
PROVISIONING_ARTIFACT_ROOT=
PROVISIONING_AWS_PROFILE=
TERRAFORM_BIN=terraform
# Ticket 03: analysis source workspaces (outside the service directory). Empty uses the OS temp directory.
ANALYSIS_WORKSPACE_ROOT=
# Ticket 10 worker: gcloud configuration and expected Google ADC principal for GCP Apply.
PROVISIONING_GCLOUD_CONFIGURATION=
PROVISIONING_GCP_ADC_EMAIL=
# Ticket 19: real analysis steps run only when both the store and the workspace are set.
ANALYSIS_ARTIFACT_STORE_DIR=
ANALYSIS_RESOURCES_DIR=
ANALYSIS_AWS_REGION=ap-northeast-2
# Ticket 12/18: platform artifact store (SHA-256 file names). When set, the MigrationWorkflow planning
# step publishes real Plan Revisions from the registered Planning input instead of the scaffold path.
ARTIFACT_STORE_DIR=
