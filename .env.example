TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5433/platform
# Operator key for issuing one-time on-premises Agent enrollment tokens. Set a long random value outside Git.
AGENT_ENROLLMENT_ADMIN_KEY=
# Operator key for registering Plan approvers (ticket 07). Set a long random value outside Git.
APPROVAL_ADMIN_KEY=
# Ticket 08 worker: protected Planning artifact directory, named AWS profile and Terraform binary.
PROVISIONING_ARTIFACT_ROOT=
PROVISIONING_AWS_PROFILE=
TERRAFORM_BIN=terraform
# Ticket 03: analysis source workspaces (outside the service directory). Empty uses the OS temp directory.
ANALYSIS_WORKSPACE_ROOT=
# Ticket 10 worker: gcloud configuration and expected Google ADC principal for GCP Apply.
PROVISIONING_GCLOUD_CONFIGURATION=
PROVISIONING_GCP_ADC_EMAIL=
# Ticket 19: real analysis steps run only when both the store and the workspace are set.
ANALYSIS_ARTIFACT_STORE_DIR=
ANALYSIS_RESOURCES_DIR=
ANALYSIS_AWS_REGION=ap-northeast-2
# Ticket 12/18: platform artifact store (SHA-256 file names). When set, the MigrationWorkflow planning
# step publishes real Plan Revisions from the registered Planning input instead of the scaffold path.
ARTIFACT_STORE_DIR=
# ENV-01: uploaded `.env` files (POST /env-files), AES-256-GCM encrypted under this directory (0600).
# The key is base64url of 32 random bytes, e.g. `python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"`.
# Set it only in the server's own `.env`; losing it makes stored files unreadable.
ENV_FILE_STORE_DIR=
ENV_FILE_ENCRYPTION_KEY=
# Ticket 22: the Sandbox worker. The real loop is registered only when both of these are set
# (the store is the same directory the analysis worker writes to; share it with ARTIFACT_STORE_DIR
# so Planning can read the requirements by SHA-256).
SANDBOX_KUBECONFIG=
SANDBOX_WORKSPACE_ROOT=
SANDBOX_HELM_TIMEOUT=5m
# Application images that already exist (D-12 Build is not placed yet), pinned by digest:
# {"<resource id>": "<repository>@sha256:<digest>"}
SANDBOX_PREBUILT_IMAGES=
# Private GitHub repositories (ticket 23): `none` reads public repositories only; `env` reads a token
# from CMP_GITHUB_TOKEN in the worker's environment (development; never put the token in this file).
# Once GitHub login exists, the platform's token store replaces `env`.
SOURCE_TOKEN_RESOLVER=none
# Development only: let an analysis input name a repository on this machine (a private app).
ANALYSIS_ALLOW_LOCAL_REPOSITORIES=false
# Ticket 20 (ADR-004): Claude. Off unless LLM_ENABLED=true; the key itself is ANTHROPIC_API_KEY in the
# environment of the worker (never in this file). Limits are enforced from the ledger file.
LLM_ENABLED=false
LLM_MODEL=claude-sonnet-5-5
LLM_LEDGER_PATH=
LLM_KILL_SWITCH_PATH=
LLM_LIMIT_RUN_USD=3
LLM_LIMIT_DAY_USD=20
LLM_LIMIT_MONTH_USD=100
